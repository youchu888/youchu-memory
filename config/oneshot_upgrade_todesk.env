# 经 memory-git 远程触发：旧机升级 ToDesk（一次性）
# ENABLED=1 且 TARGET_HOST 匹配本机 WORKLOG_HOST_ID 时执行
# 成功后写 ~/.dc-platform/state/oneshot_upgrade_todesk.stamp，不会重复跑
ENABLED=1
TARGET_HOST=old-mac
WANT_VERSION=4.10.1.0
DMG_URL=https://dl.todesk.com/official/ToDesk_Installer.dmg
# FORCE=1 可强制再跑（清 stamp 或改此项后下一轮 sync）
FORCE=0
