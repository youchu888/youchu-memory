# OneHR 考勤自动打卡配置（复制为 onehr.env 后 chmod 600）

ONEHR_BASE_URL=https://m-reportsys.cc
ONEHR_EMPLOYEE_CODE=DN6517
ONEHR_PASSWORD=your_password_here

ONEHR_SCREENSHOT_DIR=/Users/mac/Desktop/CH/telegram
ONEHR_SCREENSHOT_SCRIPT=/Users/mac/.dc-platform/scripts/onehr_telegram_devices_screenshot.sh
ONEHR_LOG_DIR=/Users/mac/.dc-platform/onehr/logs

# 打卡时间窗（北京时间）
# 上班卡：周一至周六 9:30-10:00
# 下班卡：周一至周五 22:00-22:30；周六 19:00-19:30
ONEHR_CHECKIN_WINDOW_START=09:30
ONEHR_CHECKIN_WINDOW_END=10:00
ONEHR_CHECKOUT_WINDOW_START=22:00
ONEHR_CHECKOUT_WINDOW_END=22:30
ONEHR_CHECKOUT_SAT_WINDOW_START=19:00
ONEHR_CHECKOUT_SAT_WINDOW_END=19:30

# 调度：窗口内每天随机一刻（见 onehr_checkin_scheduler.py，同 jike_checkin_watcher）
