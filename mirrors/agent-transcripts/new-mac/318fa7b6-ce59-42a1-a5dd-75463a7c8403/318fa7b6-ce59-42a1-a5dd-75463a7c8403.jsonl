{"role":"assistant","message":{"content":[{"type":"tool_use","name":"Write","input":{"path":"/Users/mac/Desktop/cabinet-drawing/投影仪柜-图纸.html","contents":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\" />\n<title>投影仪柜 · 定制图纸</title>\n<style>\n  @page { size: A3 landscape; margin: 12mm; }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 24px;\n    font-family: \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;\n    color: #1a1a1a;\n    background: #f5f5f2;\n  }\n  h1 {\n    margin: 0 0 4px;\n    font-size: 22px;\n    font-weight: 600;\n    letter-spacing: 0.02em;\n  }\n  .meta {\n    color: #555;\n    font-size: 13px;\n    margin-bottom: 20px;\n    line-height: 1.6;\n  }\n  .sheet {\n    background: #fff;\n    border: 1px solid #ccc;\n    padding: 20px 24px 28px;\n    margin-bottom: 24px;\n    box-shadow: 0 1px 3px rgba(0,0,0,.06);\n  }\n  .sheet h2 {\n    margin: 0 0 12px;\n    font-size: 15px;\n    font-weight: 600;\n    border-bottom: 1px solid #ddd;\n    padding-bottom: 8px;\n  }\n  svg { display: block; max-width: 100%; height: auto; }\n  .notes {\n    font-size: 13px;\n    line-height: 1.7;\n    color: #333;\n  }\n  .notes ul { margin: 8px 0 0; padding-left: 1.2em; }\n  .notes li { margin-bottom: 4px; }\n  table {\n    border-collapse: collapse;\n    width: 100%;\n    font-size: 13px;\n    margin-top: 8px;\n  }\n  th, td {\n    border: 1px solid #ccc;\n    padding: 6px 10px;\n    text-align: left;\n  }\n  th { background: #f0f0ec; font-weight: 600; }\n  .tag {\n    display: inline-block;\n    background: #eee;\n    padding: 1px 6px;\n    border-radius: 3px;\n    font-size: 12px;\n    margin-right: 4px;\n  }\n  @media print {\n    body { background: #fff; padding: 0; }\n    .sheet { box-shadow: none; page-break-inside: avoid; }\n  }\n</style>\n</head>\n<body>\n\n<h1>投影仪地柜 · 定制加工图</h1>\n<p class=\"meta\">\n  总体外框：长 3000 × 宽 350 × 高 350（单位：mm） · 四角圆弧 · 抽屉无玻璃 · 靠墙贴合（踢脚线避让）<br>\n  投影仪仓：宽 600 · 仓内净高约 200 · 上翻盖 · 下方云台台板（无抽屉） · 靠墙留走线空腔\n</p>\n\n<!-- ========== 1. 正立面 ========== -->\n<div class=\"sheet\">\n  <h2>图 1 · 正立面（Front Elevation） · 比例约 1:20</h2>\n  <svg viewBox=\"0 0 980 280\" xmlns=\"http://www.w3.org/2000/svg\">\n    <!-- scale: 3000mm -> 900px => 0.3 px/mm; height 350 -> 105 -->\n    <defs>\n      <marker id=\"arrow\" markerWidth=\"6\" markerHeight=\"6\" refX=\"3\" refY=\"3\" orient=\"auto\">\n        <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"#333\"/>\n      </marker>\n    </defs>\n\n    <!-- floor line -->\n    <line x1=\"30\" y1=\"200\" x2=\"950\" y2=\"200\" stroke=\"#999\" stroke-width=\"1\" stroke-dasharray=\"4 3\"/>\n    <text x=\"40\" y=\"214\" font-size=\"10\" fill=\"#888\">地坪</text>\n\n    <!-- cabinet body: x=40,y=95, w=900, h=105, corner radius ~12 (R40mm approx) -->\n    <!-- Outer shell -->\n    <rect x=\"40\" y=\"95\" width=\"900\" height=\"105\" rx=\"12\" ry=\"12\" fill=\"#f7f4ef\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- Projector bay: left 600mm = 180px -->\n    <rect x=\"40\" y=\"95\" width=\"180\" height=\"105\" rx=\"12\" ry=\"12\" fill=\"#e8f0f7\" stroke=\"#222\" stroke-width=\"1.5\"/>\n    <!-- clip right of projector to square join -->\n    <rect x=\"160\" y=\"95\" width=\"60\" height=\"105\" fill=\"#e8f0f7\" stroke=\"none\"/>\n    <line x1=\"220\" y1=\"95\" x2=\"220\" y2=\"200\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- Flip lid indication (top of projector bay) -->\n    <rect x=\"48\" y=\"98\" width=\"164\" height=\"14\" fill=\"#c5d8ea\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <text x=\"130\" y=\"109\" text-anchor=\"middle\" font-size=\"9\" fill=\"#1a4a7a\">上翻盖</text>\n    <!-- hinge arcs -->\n    <path d=\"M55 98 Q70 78 90 98\" fill=\"none\" stroke=\"#1a4a7a\" stroke-width=\"0.8\" stroke-dasharray=\"2 2\"/>\n    <text x=\"95\" y=\"82\" font-size=\"8\" fill=\"#1a4a7a\">翻开示意</text>\n\n    <!-- Platform for gimbal (below lid area) -->\n    <rect x=\"52\" y=\"130\" width=\"156\" height=\"8\" fill=\"#8b6914\" stroke=\"#5c450c\" stroke-width=\"1\"/>\n    <text x=\"130\" y=\"152\" text-anchor=\"middle\" font-size=\"9\" fill=\"#5c450c\">云台安装台板</text>\n    <!-- gimbal symbol -->\n    <circle cx=\"130\" cy=\"168\" r=\"10\" fill=\"none\" stroke=\"#444\" stroke-width=\"1\"/>\n    <circle cx=\"130\" cy=\"168\" r=\"3\" fill=\"#444\"/>\n    <line x1=\"130\" y1=\"158\" x2=\"130\" y2=\"148\" stroke=\"#444\" stroke-width=\"1\"/>\n    <text x=\"130\" y=\"190\" text-anchor=\"middle\" font-size=\"8\" fill=\"#666\">云台位（无抽屉）</text>\n\n    <!-- Remaining drawers: 2400mm = 720px, split into 4 drawers of 600mm each = 180px -->\n    <!-- Drawer 1 -->\n    <rect x=\"228\" y=\"110\" width=\"172\" height=\"78\" rx=\"4\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1\"/>\n    <line x1=\"300\" y1=\"175\" x2=\"328\" y2=\"175\" stroke=\"#888\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    <text x=\"314\" y=\"148\" text-anchor=\"middle\" font-size=\"10\" fill=\"#333\">抽屉 ①</text>\n    <text x=\"314\" y=\"162\" text-anchor=\"middle\" font-size=\"8\" fill=\"#888\">无玻璃 · 实板门</text>\n\n    <!-- Drawer 2 -->\n    <rect x=\"408\" y=\"110\" width=\"172\" height=\"78\" rx=\"4\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1\"/>\n    <line x1=\"480\" y1=\"175\" x2=\"508\" y2=\"175\" stroke=\"#888\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    <text x=\"494\" y=\"148\" text-anchor=\"middle\" font-size=\"10\" fill=\"#333\">抽屉 ②</text>\n    <text x=\"494\" y=\"162\" text-anchor=\"middle\" font-size=\"8\" fill=\"#888\">无玻璃 · 实板门</text>\n\n    <!-- Drawer 3 -->\n    <rect x=\"588\" y=\"110\" width=\"172\" height=\"78\" rx=\"4\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1\"/>\n    <line x1=\"660\" y1=\"175\" x2=\"688\" y2=\"175\" stroke=\"#888\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    <text x=\"674\" y=\"148\" text-anchor=\"middle\" font-size=\"10\" fill=\"#333\">抽屉 ③</text>\n    <text x=\"674\" y=\"162\" text-anchor=\"middle\" font-size=\"8\" fill=\"#888\">无玻璃 · 实板门</text>\n\n    <!-- Drawer 4 -->\n    <rect x=\"768\" y=\"110\" width=\"164\" height=\"78\" rx=\"4\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1\"/>\n    <!-- right corner radius visual -->\n    <line x1=\"836\" y1=\"175\" x2=\"864\" y2=\"175\" stroke=\"#888\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    <text x=\"850\" y=\"148\" text-anchor=\"middle\" font-size=\"10\" fill=\"#333\">抽屉 ④</text>\n    <text x=\"850\" y=\"162\" text-anchor=\"middle\" font-size=\"8\" fill=\"#888\">无玻璃 · 实板门</text>\n\n    <!-- overall length dim -->\n    <line x1=\"40\" y1=\"240\" x2=\"940\" y2=\"240\" stroke=\"#222\" stroke-width=\"1\"/>\n    <line x1=\"40\" y1=\"235\" x2=\"40\" y2=\"245\" stroke=\"#222\"/>\n    <line x1=\"940\" y1=\"235\" x2=\"940\" y2=\"245\" stroke=\"#222\"/>\n    <text x=\"490\" y=\"256\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\">总长 3000</text>\n\n    <!-- projector width -->\n    <line x1=\"40\" y1=\"55\" x2=\"220\" y2=\"55\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <line x1=\"40\" y1=\"50\" x2=\"40\" y2=\"60\" stroke=\"#1a4a7a\"/>\n    <line x1=\"220\" y1=\"50\" x2=\"220\" y2=\"60\" stroke=\"#1a4a7a\"/>\n    <text x=\"130\" y=\"48\" text-anchor=\"middle\" font-size=\"11\" fill=\"#1a4a7a\">投影仪仓 600</text>\n\n    <!-- drawer zone -->\n    <line x1=\"220\" y1=\"55\" x2=\"940\" y2=\"55\" stroke=\"#666\" stroke-width=\"1\"/>\n    <line x1=\"940\" y1=\"50\" x2=\"940\" y2=\"60\" stroke=\"#666\"/>\n    <text x=\"580\" y=\"48\" text-anchor=\"middle\" font-size=\"11\" fill=\"#666\">抽屉区 2400（建议均分 4×600）</text>\n\n    <!-- height dim -->\n    <line x1=\"960\" y1=\"95\" x2=\"960\" y2=\"200\" stroke=\"#222\" stroke-width=\"1\"/>\n    <line x1=\"955\" y1=\"95\" x2=\"965\" y2=\"95\" stroke=\"#222\"/>\n    <line x1=\"955\" y1=\"200\" x2=\"965\" y2=\"200\" stroke=\"#222\"/>\n    <text x=\"972\" y=\"150\" font-size=\"11\" font-weight=\"600\" transform=\"rotate(90 972 150)\">高 350</text>\n\n    <!-- corner R note -->\n    <text x=\"55\" y=\"268\" font-size=\"10\" fill=\"#666\">四角外轮廓圆弧（建议 R30～R40，加工前确认）</text>\n  </svg>\n</div>\n\n<!-- ========== 2. 俯视 ========== -->\n<div class=\"sheet\">\n  <h2>图 2 · 俯视图 / 平面（Plan） · 靠墙侧在上</h2>\n  <svg viewBox=\"0 0 980 320\" xmlns=\"http://www.w3.org/2000/svg\">\n    <!-- wall -->\n    <rect x=\"30\" y=\"40\" width=\"920\" height=\"28\" fill=\"#e0e0e0\" stroke=\"#888\" stroke-width=\"1\"/>\n    <text x=\"490\" y=\"58\" text-anchor=\"middle\" font-size=\"11\" fill=\"#555\">墙面（柜体靠墙贴合，上部不留缝）</text>\n\n    <!-- cabinet top: depth 350mm = 105px at 0.3 -->\n    <rect x=\"40\" y=\"68\" width=\"900\" height=\"105\" rx=\"12\" ry=\"12\" fill=\"#f7f4ef\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- wall-side cable chase: 40mm deep void = 12px -->\n    <rect x=\"48\" y=\"72\" width=\"164\" height=\"14\" fill=\"#d4e8d4\" stroke=\"#2d6a2d\" stroke-width=\"1\" stroke-dasharray=\"3 2\"/>\n    <text x=\"130\" y=\"83\" text-anchor=\"middle\" font-size=\"8\" fill=\"#2d6a2d\">走线空腔（靠墙）</text>\n\n    <!-- projector zone -->\n    <rect x=\"48\" y=\"90\" width=\"164\" height=\"70\" fill=\"#e8f0f7\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <text x=\"130\" y=\"118\" text-anchor=\"middle\" font-size=\"10\" fill=\"#1a4a7a\">投影仪放置区</text>\n    <text x=\"130\" y=\"132\" text-anchor=\"middle\" font-size=\"9\" fill=\"#1a4a7a\">600 × 台面净深</text>\n    <text x=\"130\" y=\"146\" text-anchor=\"middle\" font-size=\"8\" fill=\"#666\">上翻盖覆盖本区</text>\n\n    <!-- divider -->\n    <line x1=\"220\" y1=\"68\" x2=\"220\" y2=\"173\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- normal top / drawer tops -->\n    <text x=\"580\" y=\"125\" text-anchor=\"middle\" font-size=\"12\" fill=\"#444\">台面 / 抽屉区顶板</text>\n    <text x=\"580\" y=\"142\" text-anchor=\"middle\" font-size=\"10\" fill=\"#888\">（下方为抽屉，无玻璃）</text>\n\n    <!-- cable holes note -->\n    <circle cx=\"80\" cy=\"79\" r=\"3\" fill=\"none\" stroke=\"#2d6a2d\" stroke-width=\"1\"/>\n    <circle cx=\"100\" cy=\"79\" r=\"3\" fill=\"none\" stroke=\"#2d6a2d\" stroke-width=\"1\"/>\n    <text x=\"175\" y=\"82\" font-size=\"7\" fill=\"#2d6a2d\">过线孔</text>\n\n    <!-- depth dim -->\n    <line x1=\"40\" y1=\"200\" x2=\"40\" y2=\"68\" stroke=\"#222\" stroke-width=\"0.8\" opacity=\"0\"/>\n    <line x1=\"20\" y1=\"68\" x2=\"20\" y2=\"173\" stroke=\"#222\" stroke-width=\"1\"/>\n    <line x1=\"15\" y1=\"68\" x2=\"25\" y2=\"68\" stroke=\"#222\"/>\n    <line x1=\"15\" y1=\"173\" x2=\"25\" y2=\"173\" stroke=\"#222\"/>\n    <text x=\"12\" y=\"125\" font-size=\"11\" font-weight=\"600\" text-anchor=\"middle\" transform=\"rotate(-90 12 125)\">宽(深) 350</text>\n\n    <!-- length -->\n    <line x1=\"40\" y1=\"200\" x2=\"940\" y2=\"200\" stroke=\"#222\" stroke-width=\"1\"/>\n    <line x1=\"40\" y1=\"195\" x2=\"40\" y2=\"205\" stroke=\"#222\"/>\n    <line x1=\"940\" y1=\"195\" x2=\"940\" y2=\"205\" stroke=\"#222\"/>\n    <text x=\"490\" y=\"218\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\">3000</text>\n\n    <line x1=\"40\" y1=\"230\" x2=\"220\" y2=\"230\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <line x1=\"40\" y1=\"225\" x2=\"40\" y2=\"235\" stroke=\"#1a4a7a\"/>\n    <line x1=\"220\" y1=\"225\" x2=\"220\" y2=\"235\" stroke=\"#1a4a7a\"/>\n    <text x=\"130\" y=\"248\" text-anchor=\"middle\" font-size=\"11\" fill=\"#1a4a7a\">投影仪仓 600</text>\n\n    <!-- skirting note -->\n    <rect x=\"40\" y=\"265\" width=\"900\" height=\"30\" fill=\"#fafafa\" stroke=\"#ccc\" stroke-width=\"1\"/>\n    <text x=\"490\" y=\"284\" text-anchor=\"middle\" font-size=\"11\" fill=\"#555\">\n      靠墙贴合说明：柜背下部做踢脚线避让缺口（高 60 × 进深 20），上部柜背紧贴墙面，正面看无缝\n    </text>\n  </svg>\n</div>\n\n<!-- ========== 3. 侧剖 · 投影仪仓 ========== -->\n<div class=\"sheet\">\n  <h2>图 3 · 侧剖面 A-A（投影仪仓） · 重点：翻盖 / 云台台 / 走线 / 踢脚线</h2>\n  <svg viewBox=\"0 0 520 420\" xmlns=\"http://www.w3.org/2000/svg\">\n    <!-- wall -->\n    <rect x=\"40\" y=\"30\" width=\"18\" height=\"340\" fill=\"#ddd\" stroke=\"#888\"/>\n    <text x=\"49\" y=\"200\" font-size=\"10\" fill=\"#666\" text-anchor=\"middle\" transform=\"rotate(-90 49 200)\">墙</text>\n\n    <!-- skirting on wall: 20 deep x 60 high -->\n    <!-- scale: 1px = 2mm for this detail view => depth 350=175, height 350=175 -->\n    <rect x=\"58\" y=\"310\" width=\"10\" height=\"30\" fill=\"#999\" stroke=\"#666\"/>\n    <text x=\"95\" y=\"328\" font-size=\"9\" fill=\"#666\">踢脚线 高60×宽20</text>\n\n    <!-- cabinet outer -->\n    <!-- back at x=58 (flush above skirting), front at x=58+175=233 -->\n    <!-- top y=160, bottom y=335 -->\n    <!-- height 350mm = 175px -->\n\n    <!-- main body outline -->\n    <path d=\"M68 160 L225 160 Q233 160 233 168 L233 327 Q233 335 225 335 L78 335 L78 305 L68 305 Z\"\n          fill=\"#f7f4ef\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- skirting cutout (rear bottom) -->\n    <path d=\"M58 305 L78 305 L78 335\" fill=\"none\" stroke=\"#c44\" stroke-width=\"1.5\"/>\n    <text x=\"100\" y=\"350\" font-size=\"9\" fill=\"#c44\">踢脚避让缺口 H60×D20</text>\n\n    <!-- flush to wall above skirting -->\n    <line x1=\"58\" y1=\"160\" x2=\"58\" y2=\"305\" stroke=\"#2d6a2d\" stroke-width=\"2\"/>\n    <text x=\"72\" y=\"230\" font-size=\"9\" fill=\"#2d6a2d\">柜背贴墙</text>\n\n    <!-- flip lid -->\n    <rect x=\"68\" y=\"160\" width=\"157\" height=\"10\" fill=\"#c5d8ea\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <text x=\"145\" y=\"152\" text-anchor=\"middle\" font-size=\"10\" fill=\"#1a4a7a\">上翻盖（合页在靠墙侧）</text>\n    <!-- open lid dashed -->\n    <path d=\"M68 160 Q40 100 68 70\" fill=\"none\" stroke=\"#1a4a7a\" stroke-width=\"1\" stroke-dasharray=\"3 2\"/>\n    <rect x=\"55\" y=\"55\" width=\"157\" height=\"10\" fill=\"none\" stroke=\"#1a4a7a\" stroke-width=\"1\" stroke-dasharray=\"3 2\" transform=\"rotate(-55 68 160)\"/>\n    <text x=\"130\" y=\"48\" font-size=\"8\" fill=\"#1a4a7a\">翻开状态</text>\n\n    <!-- cable chase void at back -->\n    <rect x=\"68\" y=\"170\" width=\"22\" height=\"100\" fill=\"#d4e8d4\" stroke=\"#2d6a2d\" stroke-width=\"1\" stroke-dasharray=\"2 2\"/>\n    <text x=\"79\" y=\"225\" font-size=\"8\" fill=\"#2d6a2d\" text-anchor=\"middle\" transform=\"rotate(-90 79 225)\">走线空腔</text>\n\n    <!-- projector bay height ~200mm = 100px from top inner -->\n    <rect x=\"95\" y=\"175\" width=\"120\" height=\"55\" fill=\"#e8f0f7\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <text x=\"155\" y=\"200\" text-anchor=\"middle\" font-size=\"9\" fill=\"#1a4a7a\">投影仪</text>\n    <text x=\"155\" y=\"214\" text-anchor=\"middle\" font-size=\"8\" fill=\"#1a4a7a\">放置净高≈200</text>\n\n    <!-- gimbal platform -->\n    <rect x=\"95\" y=\"235\" width=\"120\" height=\"12\" fill=\"#8b6914\" stroke=\"#5c450c\" stroke-width=\"1\"/>\n    <text x=\"155\" y=\"244\" text-anchor=\"middle\" font-size=\"8\" fill=\"#fff\">云台安装台板</text>\n\n    <!-- space below platform to bottom - open / no drawer -->\n    <rect x=\"95\" y=\"247\" width=\"120\" height=\"70\" fill=\"#fafafa\" stroke=\"#aaa\" stroke-width=\"1\" stroke-dasharray=\"2 2\"/>\n    <text x=\"155\" y=\"280\" text-anchor=\"middle\" font-size=\"9\" fill=\"#888\">下方无抽屉</text>\n    <text x=\"155\" y=\"294\" text-anchor=\"middle\" font-size=\"8\" fill=\"#888\">可作开放格 / 检修口</text>\n\n    <!-- gimbal mount holes -->\n    <circle cx=\"140\" cy=\"241\" r=\"2\" fill=\"#333\"/>\n    <circle cx=\"170\" cy=\"241\" r=\"2\" fill=\"#333\"/>\n\n    <!-- dimensions -->\n    <line x1=\"250\" y1=\"160\" x2=\"250\" y2=\"335\" stroke=\"#222\" stroke-width=\"1\"/>\n    <line x1=\"245\" y1=\"160\" x2=\"255\" y2=\"160\" stroke=\"#222\"/>\n    <line x1=\"245\" y1=\"335\" x2=\"255\" y2=\"335\" stroke=\"#222\"/>\n    <text x=\"268\" y=\"250\" font-size=\"11\" font-weight=\"600\">H 350</text>\n\n    <line x1=\"250\" y1=\"170\" x2=\"250\" y2=\"270\" stroke=\"#1a4a7a\" stroke-width=\"0.8\"/>\n    <!-- projector clear height marker inside -->\n    <line x1=\"280\" y1=\"175\" x2=\"280\" y2=\"235\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <line x1=\"275\" y1=\"175\" x2=\"285\" y2=\"175\" stroke=\"#1a4a7a\"/>\n    <line x1=\"275\" y1=\"235\" x2=\"285\" y2=\"235\" stroke=\"#1a4a7a\"/>\n    <text x=\"300\" y=\"210\" font-size=\"10\" fill=\"#1a4a7a\">仓高≈200</text>\n\n    <line x1=\"68\" y1=\"370\" x2=\"233\" y2=\"370\" stroke=\"#222\" stroke-width=\"1\"/>\n    <line x1=\"68\" y1=\"365\" x2=\"68\" y2=\"375\" stroke=\"#222\"/>\n    <line x1=\"233\" y1=\"365\" x2=\"233\" y2=\"375\" stroke=\"#222\"/>\n    <text x=\"150\" y=\"390\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"600\">深 350</text>\n\n    <line x1=\"58\" y1=\"305\" x2=\"78\" y2=\"305\" stroke=\"#c44\" stroke-width=\"1\"/>\n    <text x=\"68\" y=\"300\" text-anchor=\"middle\" font-size=\"8\" fill=\"#c44\">20</text>\n  </svg>\n</div>\n\n<!-- ========== 4. 侧剖 · 抽屉区 ========== -->\n<div class=\"sheet\">\n  <h2>图 4 · 侧剖面 B-B（抽屉区）</h2>\n  <svg viewBox=\"0 0 480 400\" xmlns=\"http://www.w3.org/2000/svg\">\n    <rect x=\"40\" y=\"30\" width=\"18\" height=\"320\" fill=\"#ddd\" stroke=\"#888\"/>\n    <rect x=\"58\" y=\"290\" width=\"10\" height=\"30\" fill=\"#999\" stroke=\"#666\"/>\n\n    <path d=\"M68 140 L225 140 Q233 140 233 148 L233 307 Q233 315 225 315 L78 315 L78 285 L68 285 Z\"\n          fill=\"#f7f4ef\" stroke=\"#222\" stroke-width=\"1.5\"/>\n    <line x1=\"58\" y1=\"140\" x2=\"58\" y2=\"285\" stroke=\"#2d6a2d\" stroke-width=\"2\"/>\n\n    <!-- top panel -->\n    <rect x=\"68\" y=\"140\" width=\"157\" height=\"12\" fill=\"#e8e4dc\" stroke=\"#222\" stroke-width=\"1\"/>\n    <text x=\"145\" y=\"149\" text-anchor=\"middle\" font-size=\"8\" fill=\"#555\">台面顶板</text>\n\n    <!-- drawer box -->\n    <rect x=\"78\" y=\"160\" width=\"140\" height=\"130\" fill=\"#fff\" stroke=\"#333\" stroke-width=\"1\"/>\n    <rect x=\"85\" y=\"168\" width=\"126\" height=\"114\" fill=\"#fafafa\" stroke=\"#aaa\" stroke-width=\"1\"/>\n    <text x=\"148\" y=\"220\" text-anchor=\"middle\" font-size=\"11\" fill=\"#333\">抽屉（实板面板）</text>\n    <text x=\"148\" y=\"236\" text-anchor=\"middle\" font-size=\"9\" fill=\"#c44\">禁止玻璃门 / 玻璃面</text>\n    <line x1=\"130\" y1=\"280\" x2=\"165\" y2=\"280\" stroke=\"#888\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n\n    <!-- optional rear cable for whole run -->\n    <rect x=\"68\" y=\"155\" width=\"10\" height=\"120\" fill=\"#d4e8d4\" stroke=\"#2d6a2d\" stroke-width=\"0.8\" stroke-dasharray=\"2 2\"/>\n    <text x=\"73\" y=\"220\" font-size=\"7\" fill=\"#2d6a2d\" text-anchor=\"middle\" transform=\"rotate(-90 73 220)\">可选通长走线槽</text>\n\n    <text x=\"100\" y=\"340\" font-size=\"9\" fill=\"#c44\">踢脚避让同图3</text>\n\n    <line x1=\"250\" y1=\"140\" x2=\"250\" y2=\"315\" stroke=\"#222\"/>\n    <line x1=\"245\" y1=\"140\" x2=\"255\" y2=\"140\" stroke=\"#222\"/>\n    <line x1=\"245\" y1=\"315\" x2=\"255\" y2=\"315\" stroke=\"#222\"/>\n    <text x=\"265\" y=\"230\" font-size=\"11\" font-weight=\"600\">H 350</text>\n\n    <line x1=\"68\" y1=\"350\" x2=\"233\" y2=\"350\" stroke=\"#222\"/>\n    <text x=\"150\" y=\"370\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"600\">深 350</text>\n  </svg>\n</div>\n\n<!-- ========== 5. 轴测示意 ========== -->\n<div class=\"sheet\">\n  <h2>图 5 · 三维示意（非精确比例，仅表达分区）</h2>\n  <svg viewBox=\"0 0 900 380\" xmlns=\"http://www.w3.org/2000/svg\">\n    <!-- simple isometric-ish cabinet -->\n    <!-- front face -->\n    <path d=\"M80 180 L80 280 Q80 295 95 295 L720 295 Q735 295 735 280 L735 180 Q735 165 720 165 L95 165 Q80 165 80 180 Z\"\n          fill=\"#f0ebe3\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- top face -->\n    <path d=\"M95 165 L720 165 L760 120 L135 120 Z\" fill=\"#e5dfd4\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- right face -->\n    <path d=\"M735 180 L735 280 L760 235 L760 135 L735 165 Z\" fill=\"#d9d2c6\" stroke=\"#222\" stroke-width=\"1.5\"/>\n\n    <!-- projector bay highlight on top -->\n    <path d=\"M135 120 L280 120 L265 165 L95 165 Z\" fill=\"#c5d8ea\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <text x=\"180\" y=\"148\" font-size=\"11\" fill=\"#1a4a7a\" font-weight=\"600\">上翻盖</text>\n\n    <!-- projector front zone -->\n    <rect x=\"95\" y=\"175\" width=\"155\" height=\"105\" fill=\"#d6e6f2\" stroke=\"#1a4a7a\" stroke-width=\"1\"/>\n    <text x=\"172\" y=\"215\" text-anchor=\"middle\" font-size=\"11\" fill=\"#1a4a7a\">投影仪仓</text>\n    <text x=\"172\" y=\"232\" text-anchor=\"middle\" font-size=\"9\" fill=\"#5c450c\">下：云台台板</text>\n    <text x=\"172\" y=\"248\" text-anchor=\"middle\" font-size=\"9\" fill=\"#666\">无抽屉</text>\n\n    <!-- drawers -->\n    <rect x=\"265\" y=\"180\" width=\"105\" height=\"95\" fill=\"#fff\" stroke=\"#333\"/>\n    <rect x=\"380\" y=\"180\" width=\"105\" height=\"95\" fill=\"#fff\" stroke=\"#333\"/>\n    <rect x=\"495\" y=\"180\" width=\"105\" height=\"95\" fill=\"#fff\" stroke=\"#333\"/>\n    <rect x=\"610\" y=\"180\" width=\"110\" height=\"95\" fill=\"#fff\" stroke=\"#333\"/>\n    <text x=\"317\" y=\"230\" text-anchor=\"middle\" font-size=\"10\">①</text>\n    <text x=\"432\" y=\"230\" text-anchor=\"middle\" font-size=\"10\">②</text>\n    <text x=\"547\" y=\"230\" text-anchor=\"middle\" font-size=\"10\">③</text>\n    <text x=\"665\" y=\"230\" text-anchor=\"middle\" font-size=\"10\">④</text>\n\n    <!-- handles -->\n    <line x1=\"300\" y1=\"255\" x2=\"335\" y2=\"255\" stroke=\"#888\" stroke-width=\"2\"/>\n    <line x1=\"415\" y1=\"255\" x2=\"450\" y2=\"255\" stroke=\"#888\" stroke-width=\"2\"/>\n    <line x1=\"530\" y1=\"255\" x2=\"565\" y2=\"255\" stroke=\"#888\" stroke-width=\"2\"/>\n    <line x1=\"645\" y1=\"255\" x2=\"680\" y2=\"255\" stroke=\"#888\" stroke-width=\"2\"/>\n\n    <!-- wall hint -->\n    <line x1=\"100\" y1=\"90\" x2=\"780\" y2=\"90\" stroke=\"#aaa\" stroke-width=\"1\" stroke-dasharray=\"4 3\"/>\n    <text x=\"440\" y=\"82\" text-anchor=\"middle\" font-size=\"10\" fill=\"#888\">墙面方向 ← 柜背贴墙</text>\n\n    <text x=\"80\" y=\"340\" font-size=\"12\" fill=\"#333\">3000 L × 350 D × 350 H · 四角圆弧</text>\n  </svg>\n</div>\n\n<!-- ========== 说明 ========== -->\n<div class=\"sheet\">\n  <h2>加工说明 & 尺寸表</h2>\n  <div class=\"notes\">\n    <table>\n      <tr><th>项目</th><th>尺寸 (mm)</th><th>备注</th></tr>\n      <tr><td>柜体外框</td><td>3000 × 350 × 350</td><td>长×宽(深)×高；四角外圆弧</td></tr>\n      <tr><td>投影仪仓</td><td>宽 600 · 仓内净高 ≈200</td><td>位于一端（可按现场改左/右）</td></tr>\n      <tr><td>上翻盖</td><td>覆盖投影仪仓台面</td><td>合页建议靠墙侧；翻开后不顶墙</td></tr>\n      <tr><td>云台台板</td><td>仓内中层台板</td><td>下方不做抽屉；预留云台螺丝孔位（按实际云台底座）</td></tr>\n      <tr><td>走线空腔</td><td>靠墙侧通高/局部留空</td><td>投影仪电源/HDMI；台板/背板开过线孔</td></tr>\n      <tr><td>踢脚线避让</td><td>高 60 × 进深 20</td><td>柜背底部缺口，使上部贴墙无缝</td></tr>\n      <tr><td>抽屉区</td><td>余下约 2400</td><td>建议 4 个抽屉均分；面板实木/多层板，不要玻璃</td></tr>\n      <tr><td>圆弧</td><td>四角 R30～R40（待确认）</td><td>俯视四角 + 立面可见圆角一致</td></tr>\n    </table>\n    <ul>\n      <li><span class=\"tag\">材料</span> 未指定材质/颜色，加工前请确认板材、封边、五金（阻尼合页、抽屉滑轨）。</li>\n      <li><span class=\"tag\">云台</span> 台板承重与开孔按所选云台说明书；建议台板厚度 ≥18mm。</li>\n      <li><span class=\"tag\">走线</span> 靠墙空腔与过线孔位置可按插座位置微调；背板可局部可拆检修。</li>\n      <li><span class=\"tag\">落地</span> 若地面不平，可加隐形调节脚，但需保证踢脚避让与贴墙效果。</li>\n    </ul>\n  </div>\n</div>\n\n<p class=\"meta\" style=\"margin-top:8px\">文件位置：桌面 <code>cabinet-drawing/投影仪柜-图纸.html</code> · 可用浏览器打开后打印为 PDF（建议 A3 横向）</p>\n\n</body>\n</html>\n"}}]}}
