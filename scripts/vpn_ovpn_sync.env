# VPN 自动续期本地配置
# Telethon 凭证从 ~/Desktop/CHcode/omdb/tgbot/.env 继承

VPN_BOT=center_dc_vpn_bot
VPN_REQUEST_CMD=/request
VPN_PROFILE_NAME=center_dc_又初

# 下载 .ovpn 保存目录（最新 + 带时间戳存档）
VPN_OVPN_DIR=/Users/mac/Desktop/CH/onehr
# 监听目录（--watch-downloads，默认与 VPN_OVPN_DIR 相同）
VPN_DOWNLOADS_DIR=/Users/mac/Desktop/CH/onehr

# 独立 Telethon 会话，避免与 tgbot 抢 user_telegram.session 锁
USER_SESSION_PATH=/Users/mac/.dc-platform/vpn/telethon/user_vpn

# VPN_REUSE_OVPN_MINUTES=60
# VPN_WATCH_POLL_SEC=8
# VPN_KEEP_PROFILES=2
